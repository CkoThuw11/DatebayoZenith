{
    "uid": "cdc-pipeline",
    "title": "CDC Pipeline Monitoring",
    "refresh": "10s",
    "schemaVersion": 38,
    "timezone": "browser",
    "panels": [
        {
            "type": "row",
            "title": "SLA Overview",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "type": "gauge",
            "title": "Data Freshness Gap per Table",
            "description": "How old is the newest CDC event in bronze? Measures now() - MAX(cdc_ts_ms). Green = fresh (< 5 min), Yellow = degraded (< 15 min), Red = SLA breach (>= 15 min). Alert fires at red.",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus-ds"
                    },
                    "expr": "cdc_freshness_gap_seconds",
                    "legendFormat": "{{table}}"
                }
            ],
            "options": {
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "showThresholdLabels": true,
                "showThresholdMarkers": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0,
                    "max": 900,
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 300
                            },
                            {
                                "color": "red",
                                "value": 900
                            }
                        ]
                    }
                }
            }
        },
        {
            "type": "row",
            "title": "Kafka to MinIO Raw",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 9
            }
        },
        {
            "type": "timeseries",
            "title": "S3 Sink Consumer Lag by Topic",
            "description": "Unconsumed messages in Kafka per topic for the S3 Sink connector. Non-zero lag means Avro files are not yet written to MinIO raw. Sustained lag > 1000 triggers a PagerDuty alert.",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 10
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus-ds"
                    },
                    "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=\"connect-minio-s3-sink-connector\"})",
                    "legendFormat": "{{topic}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 20,
                        "lineWidth": 2
                    },
                    "unit": "short",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            }
        },
        {
            "type": "row",
            "title": "Spark Processing (MinIO Raw to Bronze)",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 18
            }
        },
        {
            "type": "timeseries",
            "title": "New Rows Written to Bronze per Run",
            "description": "Deduplicated new rows written to bronze in each incremental Spark run. With checkpointing enabled, this reflects only new events since the last run — not a full snapshot. Zero rows = no new events arrived or S3 Sink flush not triggered.",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 19
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus-ds"
                    },
                    "expr": "cdc_rows_written_total",
                    "legendFormat": "{{table}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "fillOpacity": 80
                    },
                    "unit": "none",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            }
        },
        {
            "type": "timeseries",
            "title": "Spark Run Duration per Table",
            "description": "Time Spark spent processing each table per run. With incremental checkpointing, this should stay low and stable. Growth over time = increasing batch size, possible checkpoint not advancing.",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 19
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus-ds"
                    },
                    "expr": "cdc_processing_duration_seconds",
                    "legendFormat": "{{table}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2
                    },
                    "unit": "s",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            }
        }
    ]
}