MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

PG_HOST=postgres-db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=northwind

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_CONNECT_URL=http://kafka-connect:8083

# PagerDuty Alerting (Events API v2)
# Lấy từ: PagerDuty > Services > Integrations > Events API v2 > Integration Key
# Để trống nếu chưa cấu hình — pipeline vẫn chạy (graceful degradation)
PAGERDUTY_ROUTING_KEY=your_pagerduty_integration_key_here
