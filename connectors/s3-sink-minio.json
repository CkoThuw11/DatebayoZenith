{
  "name": "sink-s3-minio",
  "config": {
    "connector.class": "io.confluent.connect.s3.S3SinkConnector",
    "tasks.max": "1",
    "topics": "<TO_BE_CONFIGURED_COMMA_SEPARATED_TOPICS>",
    "s3.region": "<FILL_ME_REGION>",
    "s3.bucket.name": "<FILL_ME_BUCKET_NAME>",
    "s3.part.size": "<FILL_ME_PART_SIZE>",
    "flush.size": "<FILL_ME_FLUSH_SIZE>",
    "storage.class": "io.confluent.connect.s3.storage.S3Storage",
    "format.class": "io.confluent.connect.s3.format.parquet.ParquetFormat",
    "store.url": "http://minio:9000",
    "aws.access.key.id": "${file:/config/.env:MINIO_ROOT_USER}",
    "aws.secret.access.key": "${file:/config/.env:MINIO_ROOT_PASSWORD}"
  }
}
